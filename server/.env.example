# Local Postgres example: postgresql://user:password@localhost:5432/threedshow
# Hosted (Railway/Render/Vercel Postgres) will give you a full connection string to paste here.
DATABASE_URL="postgresql://user:password@localhost:5432/threedshow"
PORT=3001

# Comma-free single origin the frontend is served from, e.g. https://your-app.vercel.app
# Leave as * only for local development.
CORS_ORIGIN=*

# Demo mode needs no chain, no wallet, no login (writes DB only, no real transactions).
DEMO_MODE=false

# Real-chain mode only (set DEMO_MODE=false to use these):
# Local Hardhat node: http://127.0.0.1:8545
# Base Sepolia testnet: https://sepolia.base.org
RPC_URL=https://sepolia.base.org
CONTRACT_ADDRESS=
ISSUER_PRIVATE_KEY=
